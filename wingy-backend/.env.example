# ============================================================================
# LLM Provider Configuration (LiteLLM Multi-Provider Support)
# ============================================================================

# LLM Provider: Which LLM provider to use
# Options: openai, ollama
# Default: openai
LLM_PROVIDER=openai

# LLM Model: The specific model to use with the provider
# Examples:
#   - For OpenAI: gpt-4, gpt-4-turbo, gpt-3.5-turbo
#   - For Ollama: llama3.1:latest, llama2, codellama, mistral
LLM_MODEL=gpt-4

# OpenAI API Key (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Ollama Base URL (required when LLM_PROVIDER=ollama)
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# Backward Compatibility (Legacy Configuration)
# ============================================================================
# These are maintained for backward compatibility
# If LLM_MODEL is not set, OPENAI_MODEL will be used
# OPENAI_MODEL=gpt-4

# ============================================================================
# Application Configuration
# ============================================================================

# Optional: Tracing configuration
ENABLE_TRACING=true

# Optional: Session storage
SESSION_DB_PATH=./data/sessions.db

# ============================================================================
# Google Custom Search API Configuration (Optional)
# ============================================================================
# Required only if you want to enable web search functionality
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# ============================================================================
# Example Configurations
# ============================================================================

# Example 1: Using OpenAI GPT-4
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4
# OPENAI_API_KEY=sk-...

# Example 2: Using local Ollama with Llama 3.1
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:latest
# OLLAMA_BASE_URL=http://localhost:11434

# Example 3: Using OpenAI GPT-3.5 (cost-optimized)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-3.5-turbo
# OPENAI_API_KEY=sk-...
